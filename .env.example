# Copy to .env and fill in. Never commit .env.

# Bot token from https://discord.com/developers/applications -> Bot
DISCORD_TOKEN=

# Your Discord user ID(s), as a JSON list. Owner-only commands (sync, announce, reload).
OWNER_IDS=[]

# Optional: a test server ID. Slash commands sync there instantly on startup.
DEV_GUILD_ID=

# Optional: load the owner-only /dev testing commands. Leave unset in production.
# DEV_MODE=true

# Needs "Message Content Intent" switched on in the Developer Portal (Bot page).
# Set to false to run without c! prefix commands (slash and @mention still work).
# MESSAGE_CONTENT_INTENT=true
# DATABASE_PATH=chonga.db
# LOG_LEVEL=INFO
# LOG_JSON=false
